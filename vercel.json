{
  "git": {
    "deploymentEnabled": {
      "*": false,
      "main": true,
      "web/rediseno-alegra": true
    }
  },
  "cleanUrls": true,
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "cobranzaactiva.com"
        }
      ],
      "destination": "https://www.cobranzaactiva.com/:path*",
      "permanent": true
    },
    {
      "source": "/empresas",
      "destination": "/plataforma/",
      "permanent": true
    },
    {
      "source": "/empresas/",
      "destination": "/plataforma/",
      "permanent": true
    },
    {
      "source": "/pago",
      "destination": "/deudores/",
      "permanent": false
    },
    {
      "source": "/pago/",
      "destination": "/deudores/",
      "permanent": false
    },
    {
      "source": "/pagar",
      "destination": "/deudores/",
      "permanent": false
    },
    {
      "source": "/pagar/",
      "destination": "/deudores/",
      "permanent": false
    },
    {
      "source": "/deuda",
      "destination": "/deudores/",
      "permanent": false
    },
    {
      "source": "/deuda/",
      "destination": "/deudores/",
      "permanent": false
    }
  ]
}
